  "fx_forward_code": "\n\n\ndef forward(self, x : torch.Tensor, w : torch.Tensor, b : torch.Tensor, target : torch.Tensor) -> tuple[torch.Tensor,torch.Tensor,torch.Tensor]:\n    matmul = x @ w;  x = w = None\n    add = matmul + b;  matmul = b = None\n    relu = torch.relu(add)\n    sub = relu - target;  target = None\n    square = sub.square();  sub = None\n    mean = square.mean();  square = None\n    return (add, relu, mean)\n    "
